APP_PIN_HASH=
SESSION_SECRET=

# Only needed when LOCAL_PADDLE_MODE=live for Baidu cloud OCR fallback.
# The legacy name PADDLEOCR_ACCESS_TOKEN also works.
BAIDU_AI_STUDIO_API_KEY=

# Local app runtime. For normal private use, .env only needs APP_PIN_HASH and
# SESSION_SECRET; these values document the defaults used when omitted.
LOCAL_DATA_DIR=data
LOCAL_HOST=127.0.0.1
LOCAL_PORT=8000
LOCAL_PADDLE_MODE=local
LOCAL_PADDLE_MODEL=PaddleOCR-VL-1.6
LOCAL_PADDLE_PYTHON=.venv_paddleocr/bin/python
LOCAL_PADDLE_PIPELINE_VERSION=v1.6
LOCAL_PADDLE_DEVICE=cpu
LOCAL_PADDLE_VL_BACKEND=mlx-vlm-server
LOCAL_PADDLE_VL_SERVER_URL=http://127.0.0.1:8111/
LOCAL_PADDLE_VL_API_MODEL_NAME=PaddlePaddle/PaddleOCR-VL-1.6
LOCAL_PADDLE_VL_MAX_CONCURRENCY=4
LOCAL_START_MLX=true
LOCAL_START_TUNNEL=false
LOCAL_OCR_DPI=120
LOCAL_INCLUDE_PAGE_SNAPSHOTS=true
LOCAL_PADDLE_SUBMIT_TIMEOUT_SECONDS=180
LOCAL_PADDLE_AUTO_OCR_TIMEOUT_SECONDS=300
LOCAL_PADDLE_STATUS_TIMEOUT_SECONDS=30
LOCAL_PADDLE_CHUNK_PAGES=2
LOCAL_PADDLE_CHUNK_TARGET_MB=1
LOCAL_PADDLE_CHUNK_CONCURRENCY=12
LOCAL_PADDLE_CHUNK_TIMEOUT_SECONDS=180
LOCAL_PADDLE_CHUNK_RETRIES=1
LOCAL_PADDLE_CHUNK_RETRY_RASTER_DPI=160
LOCAL_PADDLE_AUTO_CHUNK_MIN_PAGES=20
LOCAL_PADDLE_AUTO_CHUNK_MIN_BYTES_PER_PAGE=350000
LOCAL_PADDLE_PAGE_SUBMIT_TIMEOUT_SECONDS=120
LOCAL_PADDLE_PAGE_SUBMIT_RETRIES=2
LOCAL_PADDLE_POLL_SECONDS=5
LOCAL_WORKER_POLL_SECONDS=1
LOCAL_CREATE_KEPUB_DEFAULT=false
LOCAL_SNAPSHOT_DPI=120
LOCAL_FIGURE_CROP_DPI=240

# Optional Kindle Comic Converter CLI support for Comic / manga jobs.
# Either install a kcc-c2e executable and set LOCAL_KCC_C2E_COMMAND=kcc-c2e,
# or clone https://github.com/ciromattia/kcc and point LOCAL_KCC_SOURCE_DIR to it.
LOCAL_KCC_C2E_COMMAND=
LOCAL_KCC_SOURCE_DIR=tmp/kcc-source-work
LOCAL_KCC_PROFILE=KoCC
LOCAL_KCC_RENDER_WIDTH=1072
LOCAL_KCC_FORCE_COLOR=true
LOCAL_KCC_DISABLE_ROTATE=true

# App guardrails. These are not test caps; tests can create temporary truncated
# PDFs without changing these values.
MAX_PDF_SIZE_MB=200
MAX_PDF_PAGES=1000
MAX_IMAGE_SIZE_MB=256
MAX_TOTAL_ASSET_MB=1024

# Optional local EPUBCheck jar.
EPUBCHECK_JAR=tmp/epubcheck-5.3.0/epubcheck.jar
