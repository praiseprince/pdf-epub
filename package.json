{
  "name": "private-pdf-to-epub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local:run": "python -m uvicorn local_app.main:app --reload --reload-dir local_app --host 127.0.0.1 --port 8000",
    "local:secrets": "python3 scripts/generate-local-secrets.py",
    "local:smoke": "python3 scripts/smoke-local.py",
    "python:test": "pytest",
    "node:check": "node --check local_app/node/math_render.mjs && node --check local_app/node/mathml_render.mjs && node --check local_app/node/paddle_client.mjs"
  },
  "dependencies": {
    "@paddleocr/api-sdk": "0.2.3",
    "mathjax-full": "^3.2.2",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22"
  }
}
